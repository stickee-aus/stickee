# Stickee environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Leave values blank unless you are running your own local services.
# NEVER put production keys in this file or in any commit.
# With everything blank, public pages run on built-in mock data; sign-in,
# donations, sync jobs and admin pages will not work.

# ── Supabase (client + server) ─────────────────────────────────────────────
# Local Supabase (`npx supabase start`) prints these for you.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin access (comma-separated lists) ───────────────────────────────────
STICKEE_ADMIN_EMAILS=
STICKEE_ADMIN_USER_IDS=
# Legacy aliases, also read by src/lib/admin-auth.ts
ADMIN_EMAILS=
ADMIN_USER_IDS=

# ── Scheduled jobs and data sync ───────────────────────────────────────────
# Shared secrets for /api/sync/* and /api/agents/* (any random string locally)
CRON_SECRET=
SYNC_SECRET=
# Free key from https://theyvoteforyou.org.au/help/data
THEYVOTEFORYOU_API_KEY=

# ── Donations (Stripe TEST mode only for development) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_DONATION_URL=
NEXT_PUBLIC_STRIPE_DONATION_LINK=

# ── Feature flags and push notifications ───────────────────────────────────
# "true" to show MP scores (off by default until the method is published)
NEXT_PUBLIC_MP_SCORE_ENABLED=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
